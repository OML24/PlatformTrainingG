# Copy to .env on the server; never commit the filled copy.
POSTGRES_PASSWORD=change-me-strong-password

ZU_DB_CONNECTION=Host=db;Database=zulms;Username=zulms;Password=change-me-strong-password
# JSON: {"current":"k1","keys":{"k1":"<base64 32-byte key>","k2":"..."}}
ZU_ENC_KEYS=
# base64, at least 64 bytes
ZU_JWT_KEY=

ZU_SMTP_HOST=
ZU_SMTP_PORT=587
ZU_SMTP_USER=
ZU_SMTP_PASSWORD=
ZU_SMTP_SSL=true

ZU_STORAGE_ROOT=/var/zu-lms/storage
ZU_LOG_ROOT=/var/zu-lms/logs
ZU_PUBLIC_BASE_URL=https://portal.zu.edu.jo
# Address of the nginx host as seen by the app container (Docker gateway); required in Production.
ZU_KNOWN_PROXIES=REPLACE_WITH_DOCKER_GATEWAY_IP

ZU_BOOTSTRAP_ADMIN_LOGIN=admin
ZU_BOOTSTRAP_ADMIN_PASSWORD=
ZU_BOOTSTRAP_ADMIN_NAME=System Administrator
# Optional actor for the initial/maintenance `--sync` command.
ZU_SYNC_ACTOR_LOGIN=admin
