@using Microsoft.Extensions.Localization
@using System.Security.Claims
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@inject ZuLms.Application.Common.Abstractions.IPermissionService Permissions
@{
    bool hasAdminActionId = long.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out long adminActionUserId);
    bool canAddHistorical = hasAdminActionId &&
        await Permissions.HasAsync(adminActionUserId, "course.create_historical", Context.RequestAborted);
    bool canIssueCertificates = hasAdminActionId &&
        (await Permissions.HasAsync(adminActionUserId, "certificates.issue_pending", Context.RequestAborted) ||
         await Permissions.HasAsync(adminActionUserId, "page.quality.certificates", Context.RequestAborted));
}
@if (canAddHistorical || canIssueCertificates)
{
    <div class="container pb-4">
        <div class="row g-3">
            @if (canAddHistorical)
            {
                <section class="col-md-6">
                    <div class="card h-100"><div class="card-body">
                        <h2 class="h5"><i class="ti ti-history" aria-hidden="true"></i> @T["AdminActions.Historical.Title"]</h2>
                        <p class="text-muted">@T["AdminActions.Historical.Description"]</p>
                        <a class="btn btn-outline-primary" href="/quality/courses/new-historical">@T["AdminActions.Historical.Open"]</a>
                    </div></div>
                </section>
            }
            @if (canIssueCertificates)
            {
                <section class="col-md-6">
                    <div class="card h-100"><div class="card-body">
                        <h2 class="h5"><i class="ti ti-certificate" aria-hidden="true"></i> @T["AdminActions.Certificates.Title"]</h2>
                        <p class="text-muted">@T["AdminActions.Certificates.Description"]</p>
                        <a class="btn btn-outline-primary" href="/quality/certificates">@T["AdminActions.Certificates.Open"]</a>
                    </div></div>
                </section>
            }
        </div>
    </div>
}
