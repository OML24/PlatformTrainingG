@using Microsoft.Extensions.Localization
@using System.Security.Claims
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@inject ZuLms.Application.Common.Abstractions.IPermissionService Permissions
@{
    bool canReviewImpact = long.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out long impactReviewerId) &&
        (await Permissions.HasAsync(impactReviewerId, "impact.review", Context.RequestAborted) ||
         await Permissions.HasAsync(impactReviewerId, "page.instructor.impact", Context.RequestAborted));
}
@if (canReviewImpact)
{
    <div class="container pb-4">
        <section class="card border-primary" aria-labelledby="impact-review-card-title">
            <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h2 class="h5 mb-1" id="impact-review-card-title"><i class="ti ti-target-arrow" aria-hidden="true"></i> @T["ImpactReview.Card.Title"]</h2>
                    <p class="text-muted mb-0">@T["ImpactReview.Card.Description"]</p>
                </div>
                <a class="btn btn-primary flex-shrink-0" href="/impact/review">
                    <i class="ti ti-eye-check" aria-hidden="true"></i> @T["ImpactReview.Card.Open"]
                </a>
            </div>
        </section>
    </div>
}
