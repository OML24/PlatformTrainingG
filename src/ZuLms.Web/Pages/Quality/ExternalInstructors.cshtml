@page "/quality/external-instructors"
@{ ViewData["Title"] = "المدربون الخارجيون"; }
<div class="container py-4" id="quality-external-page">
  <div class="d-flex justify-content-between align-items-center gap-2 mb-3"><div><h1>المدربون الخارجيون</h1><p class="text-muted mb-0">البحث في الحسابات الخارجية الجاهزة للاختيار في الدورات.</p></div><a class="btn btn-primary" href="/quality/courses/new">إنشاء دورة وطلب مدرب جديد</a></div>
