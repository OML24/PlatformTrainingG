@page "/admin/roles"
@{ ViewData["Title"] = "مصفوفة الأدوار والصلاحيات"; }
<div class="container py-4" id="roles-page">
  <h1>مصفوفة الأدوار والصلاحيات</h1>
  <p class="text-muted">اختر دوراً، راجع الصلاحيات الممنوحة له، ثم احفظ التغييرات.</p>
  <div id="roles-error" class="alert alert-danger d-none" role="alert"></div>
  <div id="roles-success" class="alert alert-success d-none" role="status"></div>
  <div class="row g-3 mb-3">
    <div class="col-md-4"><label class="form-label" for="roles-role">الدور</label><select id="roles-role" class="form-select"></select></div>
    <div class="col-md-8"><label class="form-label" for="roles-search">بحث في الصلاحيات</label><input id="roles-search" class="form-control" type="search" /></div>
  </div>
  <form id="roles-form">
    <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>منح</th><th>الصلاحية</th><th>النطاق</th></tr></thead><tbody id="roles-rows"></tbody></table></div>
    <div class="roles-save-bar"><span id="roles-selected-count" class="text-muted"></span><button id="roles-save" class="btn btn-primary" type="submit">حفظ صلاحيات الدور</button></div>
  </form>
</div>
@section Scripts { <script src="~/js/admin-roles.js" asp-append-version="true"></script> }
