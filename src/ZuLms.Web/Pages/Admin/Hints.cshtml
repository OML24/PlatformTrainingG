@page "/admin/hints"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@{
    ViewData["Title"] = T["Hints.Title"];
}
<div class="container py-4" id="hints-page"
     data-error="@T["Settings.Error"]"
     data-empty="@T["Hints.Empty"]"
     data-saved="@T["Hints.Saved"]"
     data-deactivated="@T["Hints.Deactivated"]"
     data-confirm="@T["Hints.Deactivate"]"
     data-cancel="@T["Hints.Cancel"]"
     data-new="@T["Hints.New"]">
    <h1>@T["Hints.Title"]</h1>
    <div class="alert alert-danger d-none" id="hints-error" role="alert"></div>
    <div class="alert alert-success d-none" id="hints-success" role="status"></div>

    <form id="hint-form" class="card card-body mb-4">
        <h2 class="h5" id="hint-form-title">@T["Hints.New"]</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="hint-field-key">@T["Hints.FieldKey"]</label>
                <input id="hint-field-key" name="fieldKey" class="form-control" required maxlength="120" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="hint-context-key">@T["Hints.ContextKey"]</label>
                <input id="hint-context-key" name="contextKey" class="form-control" required maxlength="80" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="hint-enabled">@T["Hints.Enabled"]</label>
                <div class="form-check form-switch mt-2">
                    <input id="hint-enabled" name="isEnabled" type="checkbox" class="form-check-input" checked />
                    <label class="form-check-label" for="hint-enabled">@T["Hints.Enabled"]</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="hint-ar">@T["Hints.HintAr"]</label>
                <textarea id="hint-ar" name="hintAr" class="form-control" rows="3" required maxlength="1000"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="hint-en">@T["Hints.HintEn"]</label>
                <textarea id="hint-en" name="hintEn" class="form-control" rows="3" maxlength="1000"></textarea>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button id="hint-save" class="btn btn-primary" type="submit">@T["Hints.Save"]</button>
            <button id="hint-cancel" class="btn btn-outline-secondary d-none" type="button">@T["Hints.Cancel"]</button>
        </div>
    </form>

    <div class="d-flex gap-2 mb-3">
        <input id="hints-search" class="form-control" type="search" placeholder="@T["Credentials.SearchPermission"]" />
        <button id="hints-refresh" class="btn btn-outline-secondary" type="button">@T["Hints.Title"]</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@T["Hints.FieldKey"]</th>
                    <th>@T["Hints.ContextKey"]</th>
                    <th>@T["Hints.HintAr"]</th>
                    <th>@T["Hints.Enabled"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="hints-rows"></tbody>
        </table>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button id="hints-prev" class="btn btn-outline-secondary" type="button">‹</button>
        <span id="hints-page-number"></span>
        <button id="hints-next" class="btn btn-outline-secondary" type="button">›</button>
    </div>
</div>
@section Scripts {
    <script src="~/js/hints-admin.js" asp-append-version="true"></script>
}
