@page "/admin/password-policy"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@{
    ViewData["Title"] = T["Policy.Title"];
}
<div class="container py-4" id="policy-page" data-error="@T["Policy.Error"]" data-delete="@T["Policy.DeleteConfirm"]">
    <h1>@T["Policy.Title"]</h1>
    <p class="text-muted">@T["Policy.Help"]</p>
    <div class="alert alert-danger d-none" id="policy-message" role="alert"></div>
    <section class="card mb-4">
        <div class="card-body">
            <h2 class="h5">@T["Policy.Rules"]</h2>
            <form id="policy-form">
                <div class="row g-3 mb-3">
                    <div class="col-md-4"><label class="form-label" for="minLength">@T["Policy.MinLength"]</label><input class="form-control" id="minLength" name="minLength" type="number" min="1" required /></div>
                    <div class="col-md-4"><label class="form-label" for="maxLength">@T["Policy.MaxLength"]</label><input class="form-control" id="maxLength" name="maxLength" type="number" min="1" required /></div>
                    <div class="col-md-4"><label class="form-label" for="rotationDays">@T["Policy.RotationDays"]</label><input class="form-control" id="rotationDays" name="rotationDays" type="number" min="1" /></div>
                </div>
                <div class="row g-2 mb-3">
                    @foreach (var field in new[] { "allowSpaces", "allowArabic", "blockCommon", "blockContext", "requireUpper", "requireLower", "requireDigit", "requireSymbol" })
                    {
                        <div class="col-md-4"><label class="form-check"><input class="form-check-input" name="@field" type="checkbox" /><span class="form-check-label">@T[$"Policy.{field}"]</span></label></div>
                    }
                </div>
                <button class="btn btn-primary" type="submit">@T["Policy.Save"]</button>
            </form>
        </div>
    </section>
    <section class="card">
        <div class="card-body">
            <h2 class="h5">@T["Policy.Blocked"]</h2>
            <form id="blocked-add-form" class="row g-2 mb-3">
                <div class="col-md-6"><label class="form-label" for="blocked-password">@T["Policy.Word"]</label><input class="form-control" id="blocked-password" name="password" required maxlength="200" /></div>
                <div class="col-md-auto align-self-end"><button class="btn btn-outline-primary" type="submit">@T["Policy.Add"]</button></div>
            </form>
            <label class="form-label" for="blocked-search">@T["Policy.Search"]</label>
            <input class="form-control mb-3" id="blocked-search" type="search" />
            <table class="table table-striped"><thead><tr><th>@T["Policy.Word"]</th><th>@T["Policy.Source"]</th><th></th></tr></thead><tbody id="blocked-rows"></tbody></table>
            <div class="d-flex gap-2"><button class="btn btn-outline-secondary" id="blocked-prev" type="button">@T["Policy.Previous"]</button><span id="blocked-page" class="align-self-center"></span><button class="btn btn-outline-secondary" id="blocked-next" type="button">@T["Policy.Next"]</button></div>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/password-policy.js" asp-append-version="true"></script>
}
