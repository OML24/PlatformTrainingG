@page "/admin/audit"
@{ ViewData["Title"] = "سجل التدقيق"; }
<div class="container py-4" id="audit-page">
  <h1>سجل التدقيق</h1>
  <div id="audit-error" class="alert alert-danger d-none" role="alert"></div>
  <form id="audit-filters" class="row g-2 mb-3">
    <div class="col-md-3"><label for="audit-search" class="form-label">بحث (الاسم، اسم الدخول، الملخص، الإجراء)</label><input id="audit-search" class="form-control" type="search" placeholder="مثال: اسم العضو أو الدورة" /></div>
    <div class="col-md-2">
      <label for="audit-category" class="form-label">الفئة</label><select id="audit-category" class="form-select">
        <option value="">الكل</option><option value="Attendance">الحضور</option><option value="Auth">الدخول</option>
        <option value="User">المستخدمون</option><option value="Permission">الصلاحيات</option><option value="Course">الدورات</option>
        <option value="Lecture">المحاضرات</option><option value="Exam">الاختبارات</option><option value="Evaluation">التقييم</option>
        <option value="Certificate">الشهادات</option><option value="Impact">الأثر</option><option value="Need">الاحتياجات</option>
        <option value="Settings">الإعدادات</option><option value="Sync">المزامنة</option><option value="Security">الأمان</option><option value="System">النظام</option>
      </select>
    </div>
    <div class="col-md-2"><label for="audit-action" class="form-label">رمز الإجراء</label><input id="audit-action" class="form-control" dir="ltr" /></div>
    <div class="col-md-2"><label for="audit-course" class="form-label">معرّف الدورة</label><input id="audit-course" class="form-control" type="number" min="1" /></div>
    <div class="col-md-2">
      <label for="audit-success" class="form-label">النتيجة</label><select id="audit-success" class="form-select">
        <option value="">الكل</option><option value="true">الناجحة</option>
        <option value="false">الفاشلة</option>
      </select>
    </div>
    <div class="col-md-2"><label for="audit-from" class="form-label">من</label><input id="audit-from" class="form-control zu-date" type="text" inputmode="numeric" /></div>
    <div class="col-md-2"><label for="audit-to" class="form-label">إلى</label><input id="audit-to" class="form-control zu-date" type="text" inputmode="numeric" /></div>
    <div class="col-md-1 align-self-end"><button class="btn btn-outline-primary w-100" type="submit">بحث</button></div>
  </form>
  <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="small text-muted">تصفية سريعة للحضور:</span>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-audit-preset="attendance.override_code_absent">ألغى المحاضر حضورًا مسجّلًا بالباركود</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-audit-preset="attendance.code_after_manual_absent">سجّل بالباركود بعد تغييبه يدويًا</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-audit-preset="attendance.manual_present">حضور يدوي دون باركود</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-audit-preset="attendance.enter_code">حضور بالباركود</button>
    <button type="button" class="btn btn-sm btn-link" data-audit-preset="">مسح</button>
    <a id="audit-export" class="btn btn-outline-secondary ms-auto" href="/api/v1/audit/export">تصدير CSV</a>
  </div>
  <div class="table-responsive">
    <table class="table table-striped table-sm">
      <thead><tr><th scope="col">#</th><th scope="col">الوقت</th><th scope="col">الحساب</th><th scope="col">الفئة</th><th scope="col">الإجراء</th><th scope="col">الكيان</th><th scope="col">الملخص</th><th scope="col">النتيجة</th><th scope="col">التفاصيل</th></tr></thead>
      <tbody id="audit-rows"></tbody>
    </table>
  </div>
  <nav aria-label="صفحات سجل التدقيق"><ul class="pagination" id="audit-pager"></ul></nav>
</div>
@section Scripts { <script src="~/js/admin-audit.js" asp-append-version="true"></script> }
