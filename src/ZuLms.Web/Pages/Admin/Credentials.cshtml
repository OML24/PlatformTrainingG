@page "/admin/credentials"
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@{
    ViewData["Title"] = T["Credentials.Title"];
}
<div class="container py-4" id="credentials-page"
     data-error="@T["Credentials.Error"]"
     data-send="@T["Credentials.Send"]"
     data-resend="@T["Credentials.Resend"]"
     data-confirm-resend="@T["Credentials.ConfirmResend"]"
     data-mark-sent="@T["Credentials.MarkSent"]"
     data-mark-failed="@T["Credentials.MarkFailed"]"
     data-confirm-sent="@T["Credentials.ConfirmSent"]"
     data-confirm-failed="@T["Credentials.ConfirmFailed"]"
     data-bulk-confirm="@T["Credentials.BulkConfirm"]"
     data-eligible="@T["Credentials.Eligible"]"
     data-sent="@T["Credentials.Sent"]"
     data-uncertain="@T["Credentials.Uncertain"]"
     data-no-email="@T["Credentials.NoEmail"]"
     data-pending="@T["Credentials.Pending"]"
     data-ineligible="@T["Credentials.Ineligible"]"
     data-yes="@T["Credentials.Yes"]"
     data-no="@T["Credentials.No"]"
     data-type-employee="@T["Credentials.Type.Employee"]"
     data-type-external-instructor="@T["Credentials.Type.ExternalInstructor"]"
     data-type-local="@T["Credentials.Type.Local"]"
     data-status-not-sent="@T["Credentials.Status.NotSent"]"
     data-status-sent="@T["Credentials.Status.Sent"]"
     data-status-failed="@T["Credentials.Status.Failed"]"
     data-status-uncertain="@T["Credentials.Status.Uncertain"]"
     data-reveal="@T["Credentials.Reveal"]"
     data-change="@T["Credentials.ChangePassword"]"
     data-edit="@T["Credentials.Edit"]"
     data-disable="@T["Credentials.Disable"]"
     data-restore="@T["Credentials.Restore"]"
     data-disable-reason="@T["Credentials.DisableReason"]"
     data-restore-confirm="@T["Credentials.RestoreConfirm"]"
     data-copy="@T["Credentials.Copy"]"
     data-roles="@T["Credentials.Roles"]"
     data-remove-role="@T["Credentials.RemoveRole"]"
     data-role-admin="@T["Credentials.Role.Admin"]"
     data-role-quality="@T["Credentials.Role.Quality"]"
     data-role-dean="@T["Credentials.Role.Dean"]"
     data-role-center-manager="@T["Credentials.Role.CenterManager"]"
     data-role-member="@T["Credentials.Role.Member"]"
     data-role-instructor="@T["Credentials.Role.Instructor"]"
     data-role-external-instructor="@T["Credentials.Role.ExternalInstructor"]"
     data-permissions="@T["Credentials.Permissions"]"
     data-inherit="@T["Credentials.Mode.Inherit"]"
     data-allow="@T["Credentials.Mode.Allow"]"
     data-deny="@T["Credentials.Mode.Deny"]"
     data-effective="@T["Credentials.Effective"]">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div><h1>@T["Credentials.Title"]</h1><p class="text-muted mb-0">@T["Credentials.Help"]</p></div>
        <div class="d-flex gap-2">
            <button type="button" id="bulk-send" class="btn btn-primary">@T["Credentials.BulkSend"]</button>
            <button type="button" id="local-open" class="btn btn-outline-primary">@T["Credentials.CreateLocal"]</button>
        </div>
    </div>
    <div class="alert alert-danger d-none" id="credentials-message" role="alert"></div>
    <div class="row g-2 mb-3">
        <div class="col-12 col-lg-4"><label class="form-label" for="credentials-search">@T["Credentials.Search"]</label><input class="form-control" id="credentials-search" type="search" /></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="credentials-filter">حالة الإرسال</label><select class="form-select" id="credentials-filter">
            @foreach (var item in new[] { "All", "NotSent", "Sent", "Failed", "Uncertain", "NoEmail", "FirstLoginPending", "Disabled" })
            {
                <option value="@item">@T[$"Credentials.Filter.{item}"]</option>
            }
        </select></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="credentials-type-filter">@T["Credentials.Type"]</label><select class="form-select" id="credentials-type-filter"><option value="">الكل</option><option value="Employee">@T["Credentials.Type.Employee"]</option><option value="ExternalInstructor">@T["Credentials.Type.ExternalInstructor"]</option><option value="Local">@T["Credentials.Type.Local"]</option></select></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="credentials-role-filter">@T["Credentials.Role"]</label><select class="form-select" id="credentials-role-filter"><option value="">الكل</option><option value="Admin">@T["Credentials.Role.Admin"]</option><option value="Quality">@T["Credentials.Role.Quality"]</option><option value="Dean">@T["Credentials.Role.Dean"]</option><option value="CenterManager">@T["Credentials.Role.CenterManager"]</option><option value="Instructor">@T["Credentials.Role.Instructor"]</option><option value="Member">@T["Credentials.Role.Member"]</option><option value="ExternalInstructor">@T["Credentials.Role.ExternalInstructor"]</option></select></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="credentials-active-filter">@T["Credentials.Active"]</label><select class="form-select" id="credentials-active-filter"><option value="">الكل</option><option value="true">@T["Credentials.Yes"]</option><option value="false">@T["Credentials.No"]</option></select></div>
        <div class="col-12 col-lg-4"><label class="form-label" for="credentials-faculty-filter">@T["Credentials.Faculty"]</label><select class="form-select" id="credentials-faculty-filter"><option value="">الكل</option></select></div>
    </div>
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr>
            <th>@T["Credentials.Name"]</th><th>@T["Credentials.Login"]</th>
            <th>@T["Credentials.Type"]</th><th>@T["Credentials.Faculty"]</th>
            <th>@T["Credentials.EmployeeStatus"]</th>
            <th>@T["Credentials.Active"]</th><th>@T["Credentials.FirstLogin"]</th>
            <th>@T["Credentials.Email"]</th><th>@T["Credentials.EmailStatus"]</th>
            <th>@T["Credentials.LastLogin"]</th><th>@T["Credentials.Actions"]</th>
        </tr></thead><tbody id="credentials-rows"></tbody>
    </table></div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" id="credentials-prev" class="btn btn-outline-secondary">@T["Policy.Previous"]</button>
        <span id="credentials-page-number"></span>
        <button type="button" id="credentials-next" class="btn btn-outline-secondary">@T["Policy.Next"]</button>
    </div>
    <dialog id="local-dialog" class="border rounded p-4" style="max-width:480px;width:calc(100% - 32px)">
        <h2 class="h5">@T["Credentials.CreateLocal"]</h2>
        <form id="local-form">
            <label class="form-label" for="local-login">@T["Credentials.Login"]</label>
            <input class="form-control mb-2" id="local-login" name="loginName" pattern="[A-Za-z0-9_.-]{3,20}" required maxlength="20" />
            <label class="form-label" for="local-name-ar">@T["Credentials.Name"]</label>
            <input class="form-control mb-2" id="local-name-ar" name="fullNameAr" required maxlength="400" />
            <label class="form-label" for="local-name-en">@T["Credentials.NameEn"]</label>
            <input class="form-control mb-2" id="local-name-en" name="fullNameEn" maxlength="400" />
            <label class="form-label" for="local-password">@T["Credentials.Password"]</label>
            <input class="form-control mb-2" id="local-password" name="password" type="password" autocomplete="new-password" required />
            <label class="form-label" for="local-language">@T["Credentials.Language"]</label>
            <select class="form-select mb-3" id="local-language" name="preferredLanguage"><option value="Ar">@T["Shared.Language.Ar"]</option><option value="En">@T["Shared.Language.En"]</option></select>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@T["Credentials.Create"]</button><button class="btn btn-outline-secondary" id="local-cancel" type="button">@T["Credentials.Cancel"]</button></div>
        </form>
    </dialog>
    <dialog id="edit-dialog" class="border rounded p-4" style="max-width:480px;width:calc(100% - 32px)">
        <h2 class="h5">@T["Credentials.Edit"]</h2>
        <form id="edit-form">
            <label class="form-label" for="edit-name-en">@T["Credentials.NameEn"]</label>
            <input class="form-control mb-2" id="edit-name-en" name="fullNameEn" maxlength="400" />
            <label class="form-label" for="edit-email">@T["Credentials.EmailOverride"]</label>
            <input class="form-control mb-2" id="edit-email" name="emailOverride" type="email" maxlength="254" />
            <label class="form-label" for="edit-language">@T["Credentials.Language"]</label>
            <select class="form-select mb-2" id="edit-language" name="preferredLanguage"><option value="Ar">@T["Shared.Language.Ar"]</option><option value="En">@T["Shared.Language.En"]</option></select>
            <label class="form-check mb-2"><input class="form-check-input" id="edit-access" name="accessOverrideAllow" type="checkbox" /><span class="form-check-label">@T["Credentials.AccessOverride"]</span></label>
            <label class="form-label" for="edit-access-reason">@T["Credentials.AccessReason"]</label>
            <textarea class="form-control mb-3" id="edit-access-reason" name="accessOverrideReason"></textarea>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@T["Credentials.Save"]</button><button class="btn btn-outline-secondary" id="edit-cancel" type="button">@T["Credentials.Cancel"]</button></div>
        </form>
    </dialog>
    <dialog id="change-dialog" class="border rounded p-4" style="max-width:480px;width:calc(100% - 32px)">
        <h2 class="h5">@T["Credentials.ChangePassword"]</h2>
        <form id="change-form">
            <label class="form-label" for="change-new">@T["Auth.ChangePassword.NewPassword"]</label>
            <input class="form-control mb-2" id="change-new" name="newPassword" type="password" autocomplete="new-password" required />
            <label class="form-check mb-3"><input class="form-check-input" id="change-required" name="requireChangeAtNextLogin" type="checkbox" /><span class="form-check-label">@T["Credentials.RequireChange"]</span></label>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@T["Credentials.Save"]</button><button class="btn btn-outline-secondary" id="change-cancel" type="button">@T["Credentials.Cancel"]</button></div>
        </form>
    </dialog>
    <dialog id="reveal-dialog" class="border rounded p-4" style="max-width:480px;width:calc(100% - 32px)">
        <h2 class="h5">@T["Credentials.Reveal"]</h2>
        <form id="reauth-form" class="d-none">
            <label class="form-label" for="reauth-password">@T["Credentials.AdminPassword"]</label>
            <input class="form-control mb-3" id="reauth-password" type="password" autocomplete="current-password" required />
            <button class="btn btn-primary mb-3" type="submit">@T["Credentials.Verify"]</button>
        </form>
        <div id="revealed-values" class="d-none">
            <label class="form-label" for="revealed-initial">@T["Credentials.InitialPassword"]</label>
            <div class="input-group mb-2"><input class="form-control" id="revealed-initial" readonly dir="ltr" /><button class="btn btn-outline-secondary copy-credential" type="button" data-target="revealed-initial">@T["Credentials.Copy"]</button></div>
            <label class="form-label" for="revealed-current">@T["Credentials.CurrentPassword"]</label>
            <div class="input-group mb-2"><input class="form-control" id="revealed-current" readonly dir="ltr" /><button class="btn btn-outline-secondary copy-credential" type="button" data-target="revealed-current">@T["Credentials.Copy"]</button></div>
        </div>
        <button class="btn btn-outline-secondary" id="reveal-close" type="button">@T["Credentials.Close"]</button>
    </dialog>
    <dialog id="roles-dialog" class="border rounded p-4" style="max-width:480px;width:calc(100% - 32px)">
        <h2 class="h5">@T["Credentials.Roles"]</h2>
        <ul id="assigned-roles" class="list-group mb-3"></ul>
        <form id="roles-form">
            <label class="form-label" for="role-code">@T["Credentials.Role"]</label>
            <select class="form-select mb-2" id="role-code" name="role">
                <option value="Admin">@T["Credentials.Role.Admin"]</option>
                <option value="Quality">@T["Credentials.Role.Quality"]</option>
                <option value="Dean">@T["Credentials.Role.Dean"]</option>
                <option value="CenterManager">@T["Credentials.Role.CenterManager"]</option>
                <option value="Member">@T["Credentials.Role.Member"]</option>
            </select>
            <label class="form-label" for="role-faculty" id="role-scope-label" data-faculty="@T["Credentials.Faculty"]" data-center="المركز / الدائرة">@T["Credentials.Faculty"]</label>
            <select class="form-select mb-1" id="role-faculty" name="scopeCenterId"></select>
            <div class="form-text mb-3" id="role-scope-hint"></div>
            <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@T["Credentials.AssignRole"]</button><button class="btn btn-outline-secondary" id="roles-close" type="button">@T["Credentials.Close"]</button></div>
        </form>
    </dialog>
    <dialog id="permissions-dialog" class="border rounded p-4" style="max-width:760px;width:calc(100% - 32px);max-height:90vh;overflow:auto">
        <h2 class="h5">@T["Credentials.Permissions"]</h2>
        <label class="form-label" for="permissions-search">@T["Credentials.SearchPermission"]</label>
        <input class="form-control mb-3" id="permissions-search" type="search" />
        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>@T["Credentials.Permission"]</th><th>@T["Credentials.Effective"]</th><th>@T["Credentials.Override"]</th></tr></thead><tbody id="permissions-rows"></tbody></table></div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" id="permissions-preview" type="button" disabled>معاينة وحفظ التغييرات</button>
            <button class="btn btn-outline-danger" id="permissions-cancel-changes" type="button" disabled>إلغاء التغييرات</button>
            <button class="btn btn-outline-secondary" id="permissions-close" type="button">@T["Credentials.Close"]</button>
        </div>
    </dialog>
    <dialog id="permissions-preview-dialog" class="border rounded p-4" style="max-width:640px;width:calc(100% - 32px)">
        <h2 class="h5">معاينة تغييرات الصلاحيات</h2>
        <ul id="permissions-preview-list" class="list-group mb-3"></ul>
        <div class="d-flex gap-2"><button class="btn btn-primary" id="permissions-apply" type="button">حفظ التغييرات</button><button class="btn btn-outline-secondary" id="permissions-preview-cancel" type="button">إلغاء</button></div>
    </dialog>
</div>
@section Scripts {
    <script src="~/js/credentials-directory.js" asp-append-version="true"></script>
}
