@page "/admin/users"
@using System.Security.Claims
@inject ZuLms.Application.Common.Abstractions.IPermissionService Permissions
@{
    ViewData["Title"] = "المستخدمون";
    long.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out long actorId);
    bool canCreate = actorId > 0 && await Permissions.HasAsync(actorId, "user.create", ViewContext.HttpContext.RequestAborted);
}
<div class="container py-4" id="admin-users-page" data-can-create="@canCreate.ToString().ToLowerInvariant()">
    <div class="mb-3">
        <h1 class="mb-1">المستخدمون</h1>
        <p class="text-muted mb-0">طلبات تهيئة حسابات المدربين الخارجيين الواردة من اعتماد مقترحات الدورات.</p>
    </div>
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><span class="nav-link active">طلبات المدربين الخارجيين</span></li>
        <li class="nav-item"><a class="nav-link" href="/admin/credentials">إدارة الحسابات</a></li>
    </ul>
    <div class="alert alert-danger d-none" id="external-requests-error" role="alert"></div>
    <div class="alert alert-success d-none" id="external-requests-success" role="status"></div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr><th>الدورة</th><th>المدرب</th><th>الجهة</th><th>البريد</th><th></th></tr>
                    </thead>
                    <tbody id="external-requests-rows"></tbody>
                </table>
            </div>
            <div class="empty-state border-0 d-none" id="external-requests-empty">
                <i class="ti ti-inbox"></i>
                <p>لا توجد طلبات مدربين خارجيين حالياً. ستظهر هنا تلقائياً عند اعتماد مقترح دورة بمدرّب خارجي.</p>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 align-items-center mt-3">
        <button id="external-requests-prev" type="button" class="btn btn-outline-secondary btn-sm">السابق</button>
        <span id="external-requests-page-number" class="small text-muted"></span>
        <button id="external-requests-next" type="button" class="btn btn-outline-secondary btn-sm">التالي</button>
    </div>

    <dialog id="external-request-dialog" class="border rounded p-4" style="max-width:480px;width:calc(100% - 32px)">
        <h2 class="h5">إنشاء حساب للمدرب الخارجي</h2>
        <p id="external-request-name"></p>
        <form id="external-request-form">
            <label class="form-label" for="external-request-login">رقم الدخول أو اسم المستخدم</label>
            <div class="input-group mb-2">
                <input id="external-request-login" class="form-control" pattern="[0-9]{4}" required inputmode="numeric" />
                <button id="external-request-suggest" type="button" class="btn btn-outline-primary">اقتراح رقم</button>
            </div>
            <label class="form-label" for="external-request-password">كلمة المرور</label>
            <input id="external-request-password" class="form-control mb-1" type="password" autocomplete="new-password" />
            <p class="small text-muted">اتركها فارغة ليولّد النظام كلمة أولية ويضعها في طابور البريد. يمكنك إرسال بيانات الدخول لاحقاً من صفحة الحسابات.</p>
            <div class="d-flex gap-2">
                <button id="external-request-submit" type="submit" class="btn btn-primary">إتمام الطلب</button>
                <button id="external-request-cancel" type="button" class="btn btn-outline-secondary">إلغاء</button>
            </div>
        </form>
    </dialog>
</div>
@section Scripts { <script src="~/js/external-instructor-requests.js" asp-append-version="true"></script> }
