@page "/impact/review"
@{ ViewData["Title"] = "مراجعة قياس الأثر"; }
<div class="container py-4" id="instructor-impact-page">
  <h1>مراجعة قياس الأثر</h1>
  <p class="text-muted">تظهر الطلبات للجودة أو العميد بحسب مسار الدورة، وللمدير في جميع الحالات.</p>
  <div id="iimpact-error" class="alert alert-danger d-none" role="alert"></div>
  <div id="iimpact-success" class="alert alert-success d-none" role="status"></div>
  <form class="row g-2 mb-3">
    <div class="col-md-6"><select id="iimpact-course" class="form-select" required></select></div>
    <div class="col-md-3"><button id="iimpact-load" class="btn btn-outline-primary w-100" type="button">عرض الطلبات</button></div>
  </form>
  <div class="table-responsive">
    <table class="table table-striped">
      <thead><tr><th>المتدرب</th><th>النوع</th><th>الترتيب</th><th>الملف</th><th>الإجراء</th></tr></thead>
      <tbody id="iimpact-rows"></tbody>
    </table>
  </div>
</div>
@section Scripts { <script src="~/js/instructor-impact.js" asp-append-version="true"></script> }
