@page
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@{
    Layout = null;
    ViewData["Title"] = T["Auth.Forgot.Title"];
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/session.js" asp-append-version="true"></script>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/tajawal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <script src="~/js/api.js" defer asp-append-version="true"></script>
    <script src="~/js/auth.js" defer asp-append-version="true"></script>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-box" aria-labelledby="auth-title">
            <img class="brand-mark" src="~/img/logo.png" alt="" asp-append-version="true" />
            <h1 id="auth-title">@T["Auth.Forgot.Title"]</h1>
            <p class="auth-subtitle">@T["Auth.Forgot.Help"]</p>
            <form id="forgot-password-form" data-api="/api/v1/auth/forgot-password" data-error="@T["Auth.Forgot.Generic"]" data-success="@T["Auth.Forgot.Generic"]">
                <div class="mb-3"><label class="form-label" for="login-name">@T["Auth.Forgot.LoginName"]</label><input class="form-control" id="login-name" name="loginName" type="text" autocomplete="username" required /></div>
                <div class="mb-3"><label class="form-label" for="email">@T["Auth.Forgot.Email"]</label><input class="form-control" id="email" name="email" type="email" autocomplete="email" required /></div>
                <button class="btn auth-submit w-100" type="submit">@T["Auth.Forgot.Submit"]</button>
                <p id="auth-message" class="auth-message" role="status"></p>
            </form>
            <div class="auth-links"><a href="/login">@T["Auth.Forgot.BackToLogin"]</a></div>
        </section>
    </main>
</body>
</html>
