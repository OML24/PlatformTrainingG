@page
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@{
    Layout = null;
    ViewData["Title"] = T["Auth.Login.Title"];
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/session.js" asp-append-version="true"></script>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/tajawal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <script src="~/js/api.js" defer asp-append-version="true"></script>
    <script src="~/js/auth.js" defer asp-append-version="true"></script>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-box" aria-labelledby="auth-title">
            <img class="brand-mark" src="~/img/logo.png" alt="" asp-append-version="true" />
            <h1 id="auth-title">@T["Auth.Login.Title"]</h1>
            <p class="auth-subtitle">@T["Auth.Login.Subtitle"]</p>
            <form id="login-form" method="post" data-api="/api/v1/auth/login" data-error="@T["Auth.Login.Invalid"]">
                <div class="mb-3">
                    <label class="form-label" for="login-name">@T["Auth.Login.LoginName"]</label>
                    <input class="form-control" id="login-name" name="loginName" type="text" autocomplete="username" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">@T["Auth.Login.Password"]</label>
                    <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" id="remember-me" name="rememberMe" type="checkbox" />
                    <label class="form-check-label" for="remember-me">@T["Auth.Login.RememberMe"]</label>
                </div>
                <button class="btn auth-submit w-100" type="submit">@T["Auth.Login.Submit"]</button>
                <p id="auth-message" class="auth-message" role="status"></p>
            </form>
            <p class="auth-help">@T["Auth.Login.FirstTimeHelp"]</p>
            <div class="auth-links"><a href="/forgot-password">@T["Auth.Login.ForgotPassword"]</a><span><a href="?culture=ar">@T["Shared.Language.Ar"]</a> · <a href="?culture=en">@T["Shared.Language.En"]</a></span></div>
        </section>
    </main>
</body>
</html>
