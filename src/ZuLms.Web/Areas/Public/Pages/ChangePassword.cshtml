@page
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<ZuLms.Web.SharedResource> T
@{
    Layout = null;
    ViewData["Title"] = T["Auth.ChangePassword.Title"];
}
<!doctype html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="~/js/session.js" asp-append-version="true"></script>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "/lib/bootstrap/dist/css/bootstrap.rtl.min.css" : "/lib/bootstrap/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/tajawal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <script src="~/js/api.js" defer asp-append-version="true"></script>
    <script src="~/js/auth.js" defer asp-append-version="true"></script>
</head>
<body>
    <main class="auth-shell">
        <section class="auth-box" aria-labelledby="auth-title">
            <img class="brand-mark" src="~/img/logo.png" alt="" asp-append-version="true" />
            <h1 id="auth-title">@T["Auth.ChangePassword.Title"]</h1>
            <p class="auth-subtitle">@T["Auth.ChangePassword.Help"]</p>
            <form id="change-password-form" data-api="/api/v1/auth/change-password" data-error="@T["Auth.ChangePassword.Error"]">
                <div class="mb-3"><label class="form-label" for="new-password">@T["Auth.ChangePassword.NewPassword"]</label><input class="form-control" id="new-password" name="newPassword" type="password" autocomplete="new-password" required /></div>
                <div class="mb-3"><label class="form-label" for="confirmation">@T["Auth.ChangePassword.Confirmation"]</label><input class="form-control" id="confirmation" name="confirmation" type="password" autocomplete="new-password" required /></div>
                <button class="btn auth-submit w-100" type="submit">@T["Auth.ChangePassword.Submit"]</button>
                <p id="auth-message" class="auth-message" role="status"></p>
            </form>
        </section>
    </main>
</body>
</html>
